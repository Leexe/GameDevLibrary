#pragma kernel InstantiateGrass

#define TWOPI 6.2831853

struct GrassData
{
    float3 position;
    float rotationY;
    float2 scale;
};

// Input
uint numGrass;
float3 boundsSize;
float2 baseGrassSize;
float2 grassSizeVariance;
float spawnHeight;
float3 boundsCenter;

// Output
RWStructuredBuffer<GrassData> grassBuffer;


uint pcg_hash(uint input)
{
    uint state = input * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float hash(uint input)
{
    return saturate(float(pcg_hash(input)) / 4294967295.0);
}

[numthreads(64, 1, 1)]
void InstantiateGrass(uint3 id : SV_DispatchThreadID)
{
    uint myIndex = id.x;
    if (myIndex >= numGrass)
    {
        return;
    }

    // Generate Random Position
    float posX = (hash(myIndex) - 0.5) * boundsSize.x + boundsCenter.x;
    float posY = spawnHeight + boundsCenter.y;
    float posZ = (hash(myIndex + 1337) - 0.5) * boundsSize.z + boundsCenter.z;
    grassBuffer[myIndex].position = float3(posX, posY, posZ);

    // Generate Random Rotation
    grassBuffer[myIndex].rotationY = TWOPI * hash(myIndex * 3);

    // Generate Random Scale
    grassBuffer[myIndex].scale = baseGrassSize + hash(myIndex * 5) * grassSizeVariance;
}

#pragma kernel CullGrass

// Input
float3 cameraPosition;
float maxRenderDistance;
float4 frustumPlanes[6];

// Output
AppendStructuredBuffer<GrassData> visibleGrassBuffer;

[numthreads(64, 1, 1)]
void CullGrass(uint3 id: SV_DispatchThreadID)
{
    uint myIndex = id.x;
    if (myIndex >= numGrass)
    {
        return;
    }

    GrassData grass = grassBuffer[myIndex];

    // Distance Culling
    float dist = distance(grass.position, cameraPosition);
    if (dist > maxRenderDistance)
    {
        return;
    }

    // Frustum Culling
    float boundRadius = max(grass.scale.x, grass.scale.y);
    bool isVisible = true;

    for (int i = 0; i < 6; i++)
    {
        float distanceFromPlane = dot(frustumPlanes[i].xyz, grass.position) + frustumPlanes[i].w;

        if (distanceFromPlane < -boundRadius)
        {
            isVisible = false;
            break;
        }
    }

    // Append
    if (isVisible)
    {
        visibleGrassBuffer.Append(grass);
    }
}
